# Public production URL, including the project directory when applicable.
# VITE_SITE_URL=https://your-domain.example/pokedex/

# Keep hash routing on GitHub Pages. Use history only with SPA fallback rules.
VITE_ROUTER_MODE=hash

# Compatible PokéAPI endpoints (HTTPS); restart Vite or rebuild after changes.
VITE_POKEAPI_REST_URL=https://pokeapi.co/api/v2
VITE_POKEAPI_GRAPHQL_URL=https://graphql.pokeapi.co/v1beta2
